#!/bin/sh /etc/rc.common
# Managed by rains boot service v1
START=99
STOP=10
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh /opt/ror2/deployment/immortalwrt-boot-start.sh
    procd_set_param stdout 1
    procd_set_param stderr 1
    # Docker owns the bounded game restart policy; this helper does not respawn.
    procd_close_instance
}

stop_service() {
    owner=$(docker inspect --format '{{ index .Config.Labels "com.docker.compose.project" }}' rains-ror2-server-1 2>/dev/null) || return 0
    [ "$owner" = rains ] || return 1
    docker stop --time 35 rains-ror2-server-1 >/dev/null
}

status_service() {
    sh /opt/ror2/deployment/immortalwrt-boot-start.sh --status
}
