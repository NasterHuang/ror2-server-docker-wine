#!/bin/sh /etc/rc.common
# Managed by rains FRP client v1
START=99
STOP=11
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /opt/ror2/deployment/frp/frpc -c /opt/ror2/deployment/frp/frpc.toml
    procd_set_param respawn 3600 5 5
    procd_set_param file /opt/ror2/deployment/frp/frpc.toml
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param limits core=0 nofile="4096 4096"
    procd_close_instance
}
