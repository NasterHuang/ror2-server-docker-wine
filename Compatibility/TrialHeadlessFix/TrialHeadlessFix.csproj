<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>Rains.TrialHeadlessFix</AssemblyName>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- References must be the exact DLLs from the deployed runtime (data/runtime). Override with -p:Live=<runtime dir>. -->
    <Live Condition="'$(Live)' == ''">$(MSBuildThisFileDirectory)../../output/runtime</Live>
    <GameManaged>$(Live)/Risk of Rain 2_Data/Managed</GameManaged>
    <BepInExCore>$(Live)/BepInEx/core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)/BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="R2API.Core"><HintPath>$(Live)/BepInEx/plugins/RiskofThunder-R2API_Core/R2API.Core/R2API.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RoR2"><HintPath>$(GameManaged)/RoR2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(GameManaged)/UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime"><HintPath>$(GameManaged)/com.unity.multiplayer-hlapi.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="HGCSharpUtils"><HintPath>$(GameManaged)/HGCSharpUtils.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
