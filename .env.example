# Copy to .env. Do not commit secrets or game files.
ROR2_IMAGE=ror2-local:experimental
PUID=1000
PGID=1000
# This is an experimental candidate, not validated latest-Steam support.
SERVER_MODE=experimental
ACK_EXPERIMENTAL=0
# SHA256 of clean Managed/RoR2.dll; must also match reviewed patch manifest.
EXPECTED_GAME_SHA256=
SERVER_HOSTNAME=RoR2 private server
SERVER_PASSWORD=change-me
MAX_PLAYERS=4
PORT=27015
STEAM_QUERY_PORT=27016
STEAM_SERVER_PORT=27017
STEAM_HEARTBEAT=1
GAMEMODE=ClassicRun
MODS_ENABLED=0
# JSON string array; never interpreted by a shell.
EXTRA_ARGS_JSON=[]
# Start with 4GB limit on the measured 11.54GiB host; measure peak usage.
MEMORY_LIMIT=4g
# Stop this game process if the shared /opt filesystem has <1GiB free.
MIN_FREE_MB=1024
# Stop a stalled startup; Compose still permits at most three failure restarts.
STARTUP_TIMEOUT_SECONDS=600
ROR2_BRIDGE_NAME=br-ror2
# Optional local plugin; requires the candidate Core package and plugin installation.
RAINS_SERVER_TOOLS=0
# Exact-build adapter for the client's real Wwise DLL; requires a reviewed Mod pack.
RAINS_RESTORE_CLIENT_WWISE=0
